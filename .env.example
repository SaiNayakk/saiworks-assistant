# Copy to ~/.saiworks-assistant.env on the phone (run.sh loads it). Never commit real values.
GEMINI_API_KEY=your-key-from-aistudio.google.com
# Required, at least 16 chars. Unlocks /api/stats, reindex and owner debug. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=
# Max model calls per day across all businesses (free tier is ~1000/day)
# DAILY_LLM_BUDGET=800
# Optional overrides
# CHAT_MODEL=gemini-3.5-flash-lite
# EMBED_MODEL=gemini-embedding-001
# PORT=8300
# Server-to-server tokens for other SaiWorks apps, one per app (>= 24 chars each):
#   SERVICE_TOKENS=waitlistdrop=<random>,invoicesnap=<random>
SERVICE_TOKENS=
